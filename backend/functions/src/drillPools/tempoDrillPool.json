                "en": "Tempo Check by Sound"
            },
            "intent": {
                "ja": "「上げる音：下ろす音」を同じ長さでハーフ素振り。ダウンが速いと音が短くなる。上下同じリズムで10回できるか確認",
                "en": "Half swing with same length 'up sound : down sound'. Fast down makes short sound. Check if you can maintain same rhythm up and down for 10 reps."
            },
            "steps": {
                "ja": [
                    "上げる音と下ろす音を同じ長さに",
                    "ハーフ素振りで確認",
                    "同じリズムで10回できるか"
                ],
                "en": [
                    "Keep up and down sound same length",
                    "Check with half swings",
                    "See if 10 reps with same rhythm"
                ]
            },
            "reps": "10",
            "tools": [],
            "ng": {
                "ja": [
                    "ダウンの音が短くなる"
                ],
                "en": [
                    "Down sound becoming shorter"
                ]
            },
            "time_sec": 90,
            "tags": [
                "home_ok"
            ],
            "cooldown_days": 5
        },
