    "drills": [
        {
            "drill_id": "swing_path_out_to_in_light_check_01",
            "metric_key": "swing_path",
            "direction": "out_to_in",
            "intensity": "light",
            "variant_type": "CHECK",
            "title": {
                "ja": "地面ライン素振り",
                "en": "Ground Line Practice Swing"
            },
            "intent": {
                "ja": "地面にクラブで軽く線を引き、その線に沿ってハーフ素振り。ダウンで外から被ると線を横切りやすい。線に沿う回数を増やして軌道を確認する",
                "en": "Draw a line on the ground with your club and make half swings along it. Coming over the top tends to cross the line. Check your path by increasing successful reps."
            },
            "steps": {
                "ja": [
                    "地面にクラブで軽く目標線を引く",
                    "その線に沿ってハーフ素振り",
                    "線を横切らず沿う回数を増やす"
                ],
                "en": [
                    "Draw a light target line on the ground with club",
                    "Make half swings along that line",
                    "Increase reps where you stay on the line"
                ]
            },
            "reps": "10",
            "tools": [
                "club"
            ],
            "ng": {
                "ja": [
                    "線を無視して速く振る"
                ],
                "en": [
                    "Swinging fast while ignoring the line"
                ]
            },
            "time_sec": 90,
            "tags": [
                "beginner_safe",
                "range_ok"
            ],
            "cooldown_days": 5
        },
        {
            "drill_id": "swing_path_out_to_in_light_sense_01",
            "metric_key": "swing_path",
            "direction": "out_to_in",
            "intensity": "light",
            "variant_type": "SENSE",
            "title": {
                "ja": "ヘッド外側落とし感覚",
                "en": "Drop Club Head Outside Feel"
            },
            "intent": {
                "ja": "トップから「ヘッドを自分の背中側に落とす」意識で、ゆっくりハーフ。被る人は前に出やすい。落とす→回すの順で「前に出ない」感覚を作る",
                "en": "From the top, feel like dropping the club head behind you with slow half swings. Those who come over tend to push forward. Create a 'drop then rotate' sequence."
            },
            "steps": {
                "ja": [
                    "トップからヘッドを背中側に落とす意識",
                    "ゆっくりハーフ素振りで確認",
                    "「落とす→回す」の順で10回"
                ],
                "en": [
                    "Feel club head dropping behind you from top",
                    "Confirm with slow half swings",
                    "Practice 'drop then rotate' sequence 10 times"
                ]
            },
            "reps": "10",
            "tools": [],
            "ng": {
                "ja": [
                    "トップから前に振り出す"
                ],
                "en": [
                    "Throwing the club forward from the top"
                ]
            },
            "time_sec": 120,
            "tags": [
                "home_ok"
            ],
            "cooldown_days": 5
        },
        {
            "drill_id": "swing_path_out_to_in_light_control_01",
            "metric_key": "swing_path",
            "direction": "out_to_in",
            "intensity": "light",
            "variant_type": "CONTROL",
            "title": {
                "ja": "右わきタオル固定",
                "en": "Right Armpit Towel Hold"
            },
            "intent": {
                "ja": "右わきにタオルを挟み、落とさずハーフ素振り。わきが開くと外から入りやすい。落ちそうなら止めてやり直し、「内側から下りる」形に寄せる",
                "en": "Place towel under right armpit and swing without dropping it. Open armpit leads to over-the-top. Stop and reset if it falls, work toward 'coming from inside' path."
            },
            "steps": {
                "ja": [
                    "右わきにタオルを挟んで構える",
                    "落とさずにハーフ素振りを10回",
                    "落ちそうなら止めてやり直す"
                ],
                "en": [
                    "Set up with towel under right armpit",
                    "Make 10 half swings without dropping it",
                    "Stop and reset if towel is about to fall"
                ]
            },
            "reps": "10",
            "tools": [
                "towel"
            ],
            "ng": {
                "ja": [
                    "わきを開けて腕で振る"
                ],
                "en": [
                    "Opening armpit and swinging with arms"
                ]
            },
            "time_sec": 120,
            "tags": [
                "home_ok"
            ],
            "cooldown_days": 5
        },
        {
