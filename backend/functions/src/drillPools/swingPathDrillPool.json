                    "テンポ固定で10回"
                ],
                "en": [
                    "Swing with '1:drop 2:rotate 3:hit'",
                    "Always carefully include step 1",
                    "Fixed tempo for 10 reps"
                ]
            },
            "reps": "10",
            "tools": [],
            "ng": {
                "ja": [
                    "1を飛ばしていきなり2に入る"
                ],
                "en": [
                    "Skipping step 1 and jumping to 2"
                ]
            },
            "time_sec": 150,
            "tags": [
                "home_ok"
            ],
            "cooldown_days": 7
        },
        {
