            "intent": {
                "ja": "実打ならハーフで3球だけ。飛距離は捨てて「狙った方向に出たか」だけ見る。カットは左へ出やすい。まっすぐ〜右へ出たら軌道が改善方向",
                "en": "Hit just 3 half shots. Ignore distance, only check direction. Cuts tend to go left. Straight to right means path is improving."
            },
            "steps": {
                "ja": [
                    "ハーフで3球だけ打つ",
                    "飛距離は無視して方向だけ見る",
                    "左に出たらカット、右に出たら改善方向"
                ],
                "en": [
                    "Hit just 3 half shots",
                    "Ignore distance, only check direction",
                    "Left = cut, right = improving path"
                ]
            },
            "reps": "3",
            "tools": [
                "ball"
            ],
            "ng": {
                "ja": [
                    "飛ばそうとしてフルスイング"
                ],
                "en": [
                    "Trying to hit far with full swing"
                ]
            },
            "time_sec": 90,
            "tags": [
                "range_ok"
            ],
            "cooldown_days": 5
        },
