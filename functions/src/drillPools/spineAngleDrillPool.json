                    "Check if hips leave the wall during half swings",
                    "Reset if they leave, complete 10 reps without leaving"
                ]
            },
            "reps": "10",
            "tools": [
                "wall"
            ],
            "ng": {
                "ja": [
                    "腰だけ固定して上体が止まる"
                ],
                "en": [
                    "Locking only your hips while your upper body freezes"
                ]
            },
            "time_sec": 90,
            "tags": [
                "beginner_safe",
                "home_ok"
            ],
            "cooldown_days": 5
        },
