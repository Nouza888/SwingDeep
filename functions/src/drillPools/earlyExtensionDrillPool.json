                "en": "Right Knee Inside Hold"
            },
            "intent": {
                "ja": "流れすぎは右ひざが外へ逃げやすい。ハーフ素振りで右ひざを内側に保つ。膝が残ると腰が流れにくい。10回で「踏ん張って回る」感覚を作る",
                "en": "Excessive sway lets right knee escape outward. Keep right knee inside during half swings. Keeping knee in prevents hip sway. Build 'brace and rotate' feel in 10 reps."
            },
            "steps": {
                "ja": [
                    "右ひざを内側に保つ意識",
                    "ハーフ素振りで膝をキープ",
                    "「踏ん張って回る」感覚を10回で作る"
                ],
                "en": [
                    "Focus on keeping right knee inside",
                    "Keep knee during half swings",
                    "Build 'brace and rotate' feel in 10 reps"
                ]
            },
            "reps": "10",
            "tools": [],
            "ng": {
                "ja": [
                    "右ひざが外に逃げる"
                ],
                "en": [
                    "Right knee escaping outward"
                ]
            },
            "time_sec": 150,
            "tags": [
                "home_ok"
            ],
            "cooldown_days": 7
        },
        {
            "drill_id": "early_extension_too_much_sway_medium_transfer_01",
            "metric_key": "early_extension",
            "direction": "too_much_sway",
            "intensity": "medium",
            "variant_type": "TRANSFER",
            "title": {
