    "drills": [
        {
            "drill_id": "early_extension_too_much_sway_light_check_01",
            "metric_key": "early_extension",
            "direction": "too_much_sway",
            "intensity": "light",
            "variant_type": "CHECK",
            "title": {
                "ja": "壁ヒップ触れ確認",
                "en": "Wall Hip Touch Check"
            },
            "intent": {
                "ja": "壁に右お尻を軽く触れて構え、ハーフ素振り。流れすぎると壁から離れる。触れたまま回れた回数を数え、10回中7回キープが目標",
                "en": "Set up with right hip lightly touching wall, make half swings. Excessive sway pulls away from wall. Count reps staying in contact, aim for 7 out of 10."
            },
            "steps": {
                "ja": [
                    "壁に右お尻を軽く触れて構える",
                    "ハーフ素振りで離れないか確認",
                    "10回中7回キープが目標"
                ],
                "en": [
                    "Set up with right hip lightly touching wall",
                    "Check if you stay in contact during half swings",
                    "Aim for 7 out of 10 staying in contact"
                ]
            },
            "reps": "10",
            "tools": [
                "wall"
            ],
            "ng": {
                "ja": [
                    "壁を無視して横に流れる"
                ],
                "en": [
                    "Ignoring wall and swaying laterally"
                ]
            },
            "time_sec": 90,
            "tags": [
                "home_ok"
            ],
            "cooldown_days": 5
        },
        {
            "drill_id": "early_extension_too_much_sway_light_sense_01",
            "metric_key": "early_extension",
            "direction": "too_much_sway",
            "intensity": "light",
            "variant_type": "SENSE",
            "title": {
                "ja": "足裏「外側」圧ドリル",
                "en": "Outside Foot Pressure Drill"
            },
            "intent": {
                "ja": "ダウンで右足外側が抜けると腰が流れやすい。ハーフ素振りで右足外側に圧を残す意識。圧が残る＝回転できてる。10回で感覚を作る",
                "en": "If outside of right foot lifts in downswing, hips tend to sway. Feel pressure on outside of right foot during half swings. Pressure remaining = rotating properly."
            },
            "steps": {
                "ja": [
                    "右足外側に圧を残す意識",
                    "ハーフ素振りで圧を確認",
                    "圧が残る感覚を10回で作る"
                ],
                "en": [
                    "Focus on keeping pressure on right foot outside",
                    "Check pressure during half swings",
                    "Build this feeling in 10 reps"
                ]
            },
            "reps": "10",
            "tools": [],
            "ng": {
                "ja": [
                    "右足が浮いて流れる"
                ],
                "en": [
                    "Right foot lifting and swaying"
                ]
            },
            "time_sec": 120,
            "tags": [
                "home_ok"
            ],
            "cooldown_days": 5
        },
        {
            "drill_id": "early_extension_too_much_sway_light_control_01",
            "metric_key": "early_extension",
            "direction": "too_much_sway",
            "intensity": "light",
            "variant_type": "CONTROL",
            "title": {
                "ja": "切り返しで一瞬止める",
                "en": "Pause at Transition"
            },
            "intent": {
                "ja": "トップで一瞬止めてからハーフで下ろす。流れる人は止められず横移動が出る。止めても腰が真横に動かない形を10回。横移動を抑える制御練習",
                "en": "Pause briefly at top then make half downswing. Those who sway can't stop and move laterally. Practice 10 times stopping without lateral hip movement."
            },
            "steps": {
                "ja": [
                    "トップで一瞬止める",
                    "止めた後にハーフで下ろす",
                    "横移動が出ない形を10回"
                ],
                "en": [
                    "Pause briefly at top",
                    "Make half downswing after pause",
                    "Practice 10 times without lateral movement"
                ]
            },
            "reps": "10",
            "tools": [],
            "ng": {
                "ja": [
                    "止められず流れる"
                ],
                "en": [
                    "Unable to pause and swaying"
                ]
            },
            "time_sec": 120,
            "tags": [
                "home_ok"
            ],
            "cooldown_days": 5
        },
        {
            "drill_id": "early_extension_too_much_sway_light_transfer_01",
            "metric_key": "early_extension",
            "direction": "too_much_sway",
            "intensity": "light",
            "variant_type": "TRANSFER",
            "title": {
                "ja": "3球だけ（左足一本にしない）",
                "en": "3 Shots (Don't Load Left Foot Only)"
            },
            "intent": {
                "ja": "実打3球。腰が流れると左足にドスンと乗りがち。左足一本にならないよう、両足の圧を感じながら当てる。流れた感触が出たら即素振りに戻す",
                "en": "Hit 3 shots. Swaying hips tend to slam onto left foot. Feel pressure on both feet, not just left. If you feel sway, immediately return to practice swings."
            },
            "steps": {
                "ja": [
                    "3球だけ打つ",
                    "両足の圧を感じながら当てる",
                    "流れた感触が出たら素振りに戻る"
                ],
                "en": [
                    "Hit just 3 shots",
                    "Feel pressure on both feet while hitting",
                    "Return to practice swings if you feel sway"
                ]
            },
            "reps": "3",
            "tools": [
                "ball"
            ],
            "ng": {
                "ja": [
                    "左足にドスンと乗る"
                ],
                "en": [
                    "Slamming weight onto left foot"
                ]
            },
            "time_sec": 90,
            "tags": [
                "range_ok"
            ],
            "cooldown_days": 5
        },
        {
            "drill_id": "early_extension_too_much_sway_medium_check_01",
            "metric_key": "early_extension",
            "direction": "too_much_sway",
            "intensity": "medium",
            "variant_type": "CHECK",
            "title": {
                "ja": "足元ラインチェック",
                "en": "Foot Line Check"
            },
            "intent": {
                "ja": "足元にクラブを置き、腰が左へ流れても体全体が同じだけズレないか確認。流れすぎは上体も左へ動く。ハーフで「回転だけ」を意識し10回確認",
                "en": "Place club at feet, check if whole body shifts when hips sway left. Excessive sway moves upper body too. Practice 10 half swings focusing on 'rotation only'."
            },
            "steps": {
                "ja": [
                    "足元にクラブを置く",
                    "ハーフ素振りで体がズレないか確認",
                    "「回転だけ」を意識して10回"
                ],
                "en": [
                    "Place club at feet",
                    "Check if body shifts during half swings",
                    "Focus on 'rotation only' for 10 reps"
                ]
            },
            "reps": "10",
            "tools": [
                "club"
            ],
            "ng": {
                "ja": [
                    "上体ごと左にズレる"
                ],
                "en": [
                    "Upper body shifting left together"
                ]
            },
            "time_sec": 120,
            "tags": [
                "home_ok"
            ],
            "cooldown_days": 7
        },
        {
            "drill_id": "early_extension_too_much_sway_medium_sense_01",
            "metric_key": "early_extension",
            "direction": "too_much_sway",
            "intensity": "medium",
            "variant_type": "SENSE",
            "title": {
                "ja": "左足つま先前の壁（止まる感）",
                "en": "Wall in Front of Left Toe (Stop Feel)"
            },
            "intent": {
                "ja": "左足つま先の少し前に目印（壁/バッグ等）を置き、腰が突っ込まない意識でハーフ。目印に向かうと流れすぎ。目印を「避ける」感覚で10回",
                "en": "Place marker (wall/bag) slightly in front of left toe, practice half swings without hips thrusting forward. Moving toward marker = too much sway. 'Avoid' marker for 10 reps."
            },
            "steps": {
                "ja": [
                    "左足つま先前に目印を置く",
                    "腰が目印に向かわない意識でハーフ",
                    "「避ける」感覚で10回"
                ],
                "en": [
                    "Place marker in front of left toe",
                    "Half swing without hips going toward marker",
                    "'Avoid' marker feel for 10 reps"
                ]
            },
            "reps": "10",
            "tools": [
                "bag"
            ],
            "ng": {
                "ja": [
                    "目印に腰が突っ込む"
                ],
                "en": [
                    "Hips thrusting toward marker"
                ]
            },
            "time_sec": 150,
            "tags": [
                "home_ok"
            ],
            "cooldown_days": 7
        },
        {
