            },
            "intent": {
                "ja": "小さめハーフで10球、テンポは一定。流れすぎは急ぐほど出る。テンポが崩れたらノーカウント。安定して回れる「速度の上限」を見つけるのが目的",
                "en": "Hit 10 small half shots at fixed tempo. Sway worsens with rushing. No count if tempo breaks. Goal is finding 'speed limit' where you can rotate stably."
            },
            "steps": {
                "ja": [
                    "小さめハーフで10球",
                    "テンポを一定に保つ",
                    "崩れたらノーカウント"
                ],
                "en": [
                    "Hit 10 small half shots",
                    "Keep tempo constant",
                    "No count if tempo breaks"
                ]
            },
            "reps": "10",
            "tools": [
                "ball"
            ],
            "ng": {
                "ja": [
                    "急いでテンポが崩れる"
